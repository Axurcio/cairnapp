# ---------------------------------------------------------------- Python
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
*.egg-info/
.eggs/
dist/
build/
pip-wheel-metadata/

# Tooling caches and reports
.pytest_cache/
.mypy_cache/
.dmypy.json
.ruff_cache/
.tox/
.nox/
.coverage
.coverage.*
coverage.xml
htmlcov/
junit*.xml
.ipynb_checkpoints/

# ---------------------------------------------------------------- Secrets and local data
# Never commit credentials. .env.example (local-only defaults) is the exception.
.env
.env.*
!.env.example
.envrc
*.pem
*.key
*.p8
*.p12
*.jks
*.keystore
*.mobileprovision
.data/
*.sqlite
*.sqlite3
*.db
*.log

# Personal Docker Compose overrides (docker-compose.yml stays committed)
docker-compose.override.yml
compose.override.yml

# ---------------------------------------------------------------- Node / Expo (apps/mobile)
node_modules/
.expo/
.expo-shared/
web-build/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.metro-health-check*
*.tsbuildinfo
apps/mobile/ios/
apps/mobile/android/

# ---------------------------------------------------------------- Editors / OS
# .vscode/ is committed (shared tasks, launch configs, extensions); personal files are not.
.vscode/*.local.json
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Copy to .env to override defaults. Every value here is LOCAL-ONLY.
# Docker Compose reads .env automatically; the app reads CAIRN_* variables.
# Nothing here is required: `docker compose up -d` works with no .env at all.

# ---- Published host ports (change if something else already uses them) ----
CAIRN_API_PORT=8000
CAIRN_WEB_PORT=3000
POSTGRES_PORT=5432
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
TEMPORAL_PORT=7233
TEMPORAL_UI_PORT=8233
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# ---- Local credentials (never reuse outside your machine) ----
POSTGRES_USER=cairn
POSTGRES_PASSWORD=cairn_local_dev_only
POSTGRES_DB=cairn
NEO4J_PASSWORD=cairn_local_dev_only
MINIO_ROOT_USER=cairn
MINIO_ROOT_PASSWORD=cairn_local_dev_only
MINIO_BUCKET=cairn-evidence

# ---- AI gateway: mock by default, no credentials needed ----
CAIRN_AI_PROVIDER=mock            # mock | openai_compatible
CAIRN_RENDERER=template           # template | llm
# CAIRN_OPENAI_BASE_URL=https://api.openai.com/v1
# CAIRN_OPENAI_API_KEY=
# CAIRN_OPENAI_MODEL=gpt-4o-mini

# ---- Derived context memory ----
CAIRN_CONTEXT_PROVIDER=graphiti   # graphiti | in_memory
CAIRN_GRAPHITI_MODE=episodes      # episodes (no LLM) | full (needs CAIRN_OPENAI_API_KEY)

# ---- Guardrails (defence-in-depth) ----
CAIRN_GUARDRAIL_PROVIDER=noop     # noop | nemo (build with CAIRN_EXTRAS=nemo)
CAIRN_EXTRAS=

# ---- Website sign-in ----
# dev = session cookies + X-Cairn-* header identities (local only); session = cookies only.
# CAIRN_AUTH_PROVIDER=dev
# CAIRN_SESSION_COOKIE_SECURE=false   # must be true behind HTTPS (required in production)
# CAIRN_SESSION_TTL_HOURS=12
# CAIRN_WEB_DEMO_ACCOUNTS=true        # list the synthetic demo accounts on the sign-in page

# ---- Logging ----
CAIRN_LOG_LEVEL=INFO
# CAIRN_LOG_SENSITIVE=false       # never true outside local debugging

# ---- Dev Container agentic CLIs (Claude Code, OpenAI Codex) ----
# Optional: set so `claude`/`codex` are pre-authenticated inside the
# container. Leave unset and run `claude login` / `codex login` instead.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
